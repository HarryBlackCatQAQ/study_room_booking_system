# keep the current application mode explicit
DJANGO_ENV=development

# keep debug enabled for local infrastructure verification
DEBUG=True

# keep the project secret key explicit in the example file
SECRET_KEY=django-insecure-change-this-later

# keep the current local hosts aligned with the project
ALLOWED_HOSTS=127.0.0.1,localhost

# keep the current local frontend origins aligned with the project
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# keep the database engine on postgresql for the read-write split setup
DB_ENGINE=postgres

# keep the main application database name aligned with the project
DB_NAME=studyroom

# keep the main application database user aligned with the project
DB_USER=studyuser

# keep the main application database password aligned with the project
DB_PASSWORD=study123456

# point write traffic to the primary postgres node
DB_HOST=127.0.0.1

# point write traffic to the primary postgres port exposed by docker
DB_PORT=5012

# enable read replica routing inside django
DB_READ_REPLICA_HOSTS=127.0.0.1,127.0.0.1

# expose the read replica ports that match the docker cluster compose file
DB_READ_REPLICA_PORTS=5014,5015

# keep unsafe requests on the primary database to avoid replica lag issues
DB_FORCE_PRIMARY_FOR_UNSAFE_METHODS=True

# keep the standalone redis channel layer available for websockets
REDIS_CHANNEL_URL=redis://:studyredis123456@127.0.0.1:5013/0

# enable the redis cluster cache backend
REDIS_CLUSTER_ENABLED=True

# point the django cache backend at the locally exposed redis cluster ports
REDIS_CLUSTER_NODES=redis://:studyredis123456@127.0.0.1:7001,redis://:studyredis123456@127.0.0.1:7002,redis://:studyredis123456@127.0.0.1:7003,redis://:studyredis123456@127.0.0.1:7004,redis://:studyredis123456@127.0.0.1:7005,redis://:studyredis123456@127.0.0.1:7006

# remap the docker-internal redis node hostnames back to local host ports for a non-containerized django process
REDIS_CLUSTER_ADDRESS_REMAP=redis-cluster-node-1:7001=127.0.0.1:7001,redis-cluster-node-2:7002=127.0.0.1:7002,redis-cluster-node-3:7003=127.0.0.1:7003,redis-cluster-node-4:7004=127.0.0.1:7004,redis-cluster-node-5:7005=127.0.0.1:7005,redis-cluster-node-6:7006=127.0.0.1:7006,172.28.0.11:7001=127.0.0.1:7001,172.28.0.12:7002=127.0.0.1:7002,172.28.0.13:7003=127.0.0.1:7003,172.28.0.14:7004=127.0.0.1:7004,172.28.0.15:7005=127.0.0.1:7005,172.28.0.16:7006=127.0.0.1:7006

# allow redis cluster reads to use replica nodes
REDIS_CLUSTER_READ_FROM_REPLICAS=True

# keep full coverage checks enabled for healthy cluster startup validation
REDIS_CLUSTER_REQUIRE_FULL_COVERAGE=True
