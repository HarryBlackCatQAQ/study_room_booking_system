# keep local git metadata out of docker build contexts
.git

# keep python virtual environments out of docker build contexts
.venv
venv

# keep local editor and macOS cache files out of docker build contexts
.DS_Store
.idea
.vscode

# keep python cache files out of docker build contexts
__pycache__
*.pyc
*.pyo
*.pyd

# keep frontend dependency caches out of docker build contexts
frontend/node_modules

# keep generated frontend cache folders out of docker build contexts
frontend/.pnpm-store
frontend/.vite

# keep local sqlite development artifacts out of docker build contexts
backend/db.sqlite3

# keep backup dumps out of docker build contexts
backups
