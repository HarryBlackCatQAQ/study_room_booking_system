# expose the shared redis password used by both the cluster and the channel layer
REDIS_PASSWORD=studyredis123456

# expose the host port for the websocket channel layer redis instance
REDIS_CHANNEL_PORT=5013

# expose the six cluster ports used by the redis cache nodes
REDIS_CLUSTER_NODE_1_PORT=7001
REDIS_CLUSTER_NODE_2_PORT=7002
REDIS_CLUSTER_NODE_3_PORT=7003
REDIS_CLUSTER_NODE_4_PORT=7004
REDIS_CLUSTER_NODE_5_PORT=7005
REDIS_CLUSTER_NODE_6_PORT=7006
