# django backend upstream
upstream studyroom_backend_pool {
    least_conn;
    server ${BACKEND_UPSTREAM_SERVER_1} max_fails=3 fail_timeout=30s;
    server ${BACKEND_UPSTREAM_SERVER_2} max_fails=3 fail_timeout=30s;
    server ${BACKEND_UPSTREAM_SERVER_3} max_fails=3 fail_timeout=30s;
    keepalive 32;
}

server {
    listen 80;
    server_name _;

    # nginx health check
    location = /nginx-healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 'ok';
    }

    # django static files
    location /static/ {
        alias /var/www/backend-static/;
        expires 1h;
        add_header Cache-Control "public";
    }

    # django admin
    location /admin/ {
        proxy_pass http://studyroom_backend_pool;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
        proxy_next_upstream error timeout http_502 http_503 http_504;
    }

    # api traffic
    location /api/ {
        proxy_pass http://studyroom_backend_pool;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
        proxy_next_upstream error timeout http_502 http_503 http_504;
    }

    # frontend app
    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
    }
}
