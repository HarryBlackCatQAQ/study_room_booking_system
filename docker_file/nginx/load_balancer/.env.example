# keep the django environment label explicit for the dockerized load balancer stack
DJANGO_ENV=load_balancer

# keep debug disabled so the dockerized stack behaves closer to deployment mode
DEBUG=False

# keep the project secret key explicit in the example file
SECRET_KEY=django-insecure-change-this-later

# keep the nginx public port separate from the local development backend port
NGINX_PUBLIC_PORT=8088

# keep the backend app container port explicit for nginx upstream routing
BACKEND_APP_PORT=8000

# keep the dockerized backend hostnames aligned with the nginx upstream configuration
BACKEND_UPSTREAM_SERVER_1=backend-app-1:8000
BACKEND_UPSTREAM_SERVER_2=backend-app-2:8000
BACKEND_UPSTREAM_SERVER_3=backend-app-3:8000

# keep the django allowed hosts aligned with host access and the nginx container
ALLOWED_HOSTS=127.0.0.1,localhost,nginx-load-balancer,studyroom_nginx_load_balancer

# keep both the local vite frontend and the dockerized nginx frontend origin available
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8088,http://127.0.0.1:8088

# trust local browser origins for django csrf validation in non-https verification flows
CSRF_TRUSTED_ORIGINS=http://localhost:8088,http://127.0.0.1:8088

# keep forwarded host and forwarded proto handling disabled until an outer https proxy is added
USE_X_FORWARDED_HOST=False
USE_SECURE_PROXY_SSL_HEADER=False

# keep transport and cookie security opt-in so local http verification still works
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# keep the database engine on postgresql for the read-write separation deployment
DB_ENGINE=postgres

# keep the shared project database name explicit
DB_NAME=studyroom

# keep the shared project database username explicit
DB_USER=studyuser

# keep the shared project database password explicit
DB_PASSWORD=study123456

# point backend writes at the postgres primary service on the shared docker network
DB_HOST=postgres-primary

# point backend writes at the internal postgres service port
DB_PORT=5432

# point backend reads at the postgres replica services on the shared docker network
DB_READ_REPLICA_HOSTS=postgres-replica-1,postgres-replica-2

# point backend reads at the internal postgres replica service ports
DB_READ_REPLICA_PORTS=5432,5432

# keep unsafe requests on the primary database to avoid replica lag after writes
DB_FORCE_PRIMARY_FOR_UNSAFE_METHODS=True

# keep the standalone redis url explicit for compatibility with existing code paths
REDIS_URL=redis://:studyredis123456@redis-channel:6379/0

# keep the websocket channel layer on the standalone redis instance
REDIS_CHANNEL_URL=redis://:studyredis123456@redis-channel:6379/0

# keep the explicit redis channel host list aligned with channels_redis
REDIS_CHANNEL_HOSTS=redis://:studyredis123456@redis-channel:6379/0

# enable the redis cluster backend for django cache traffic
REDIS_CLUSTER_ENABLED=True

# point the django cache backend at the shared redis cluster service names
REDIS_CLUSTER_NODES=redis://:studyredis123456@redis-cluster-node-1:7001,redis://:studyredis123456@redis-cluster-node-2:7002,redis://:studyredis123456@redis-cluster-node-3:7003,redis://:studyredis123456@redis-cluster-node-4:7004,redis://:studyredis123456@redis-cluster-node-5:7005,redis://:studyredis123456@redis-cluster-node-6:7006

# keep cluster replica reads enabled for cache traffic
REDIS_CLUSTER_READ_FROM_REPLICAS=True

# keep full slot coverage checks enabled for healthy cluster validation
REDIS_CLUSTER_REQUIRE_FULL_COVERAGE=True

# keep grpc targets aligned with the dockerized java and go service names
JAVA_RECOMMENDATION_GRPC_TARGET=java-recommendation-service:50061
GO_AVAILABILITY_GRPC_TARGET=go-availability-service:50062
JAVA_BOOKING_LIFECYCLE_GRPC_TARGET=java-recommendation-service:50061
