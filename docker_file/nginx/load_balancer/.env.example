# app settings
DJANGO_ENV=load_balancer

DEBUG=False

SECRET_KEY=django-insecure-change-this-later

# ports
NGINX_PUBLIC_PORT=8088

BACKEND_APP_PORT=8000

# backend upstreams
BACKEND_UPSTREAM_SERVER_1=backend-app-1:8000
BACKEND_UPSTREAM_SERVER_2=backend-app-2:8000
BACKEND_UPSTREAM_SERVER_3=backend-app-3:8000

# hosts and browser access
ALLOWED_HOSTS=127.0.0.1,localhost,nginx-load-balancer,studyroom_nginx_load_balancer

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8088,http://127.0.0.1:8088

CSRF_TRUSTED_ORIGINS=http://localhost:8088,http://127.0.0.1:8088

# proxy settings
USE_X_FORWARDED_HOST=False
USE_SECURE_PROXY_SSL_HEADER=False

# security settings
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# database
DB_ENGINE=postgres

DB_NAME=studyroom

DB_USER=studyuser

DB_PASSWORD=study123456

DB_HOST=postgres-primary

DB_PORT=5432

DB_READ_REPLICA_HOSTS=postgres-replica-1,postgres-replica-2

DB_READ_REPLICA_PORTS=5432,5432

DB_FORCE_PRIMARY_FOR_UNSAFE_METHODS=True

# redis
REDIS_URL=redis://:studyredis123456@redis-channel:6379/0

REDIS_CHANNEL_URL=redis://:studyredis123456@redis-channel:6379/0

REDIS_CHANNEL_HOSTS=redis://:studyredis123456@redis-channel:6379/0

REDIS_CLUSTER_ENABLED=True

REDIS_CLUSTER_NODES=redis://:studyredis123456@redis-cluster-node-1:7001,redis://:studyredis123456@redis-cluster-node-2:7002,redis://:studyredis123456@redis-cluster-node-3:7003,redis://:studyredis123456@redis-cluster-node-4:7004,redis://:studyredis123456@redis-cluster-node-5:7005,redis://:studyredis123456@redis-cluster-node-6:7006

REDIS_CLUSTER_READ_FROM_REPLICAS=True

REDIS_CLUSTER_REQUIRE_FULL_COVERAGE=True

# grpc services
JAVA_RECOMMENDATION_GRPC_TARGET=java-recommendation-service:5101
GO_AVAILABILITY_GRPC_TARGET=go-availability-service:5102
JAVA_BOOKING_LIFECYCLE_GRPC_TARGET=java-recommendation-service:5101
