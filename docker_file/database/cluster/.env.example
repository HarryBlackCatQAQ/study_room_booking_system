# keep the primary database name aligned with the current project
POSTGRESQL_DATABASE=studyroom

# keep the application user aligned with the current project
POSTGRESQL_USERNAME=studyuser

# keep the application password aligned with the current project
POSTGRESQL_PASSWORD=study123456

# expose a postgres superuser password for administration tasks
POSTGRESQL_POSTGRES_PASSWORD=studyroot123456

# expose the replication user used by the replica nodes
POSTGRESQL_REPLICATION_USER=replicator

# expose the replication password used by the replica nodes
POSTGRESQL_REPLICATION_PASSWORD=replicator123456

# expose the primary node on the same host port already used by the project
POSTGRESQL_PRIMARY_PORT=5012

# expose the first read replica on a dedicated host port
POSTGRESQL_REPLICA_1_PORT=5014

# expose the second read replica on a dedicated host port
POSTGRESQL_REPLICA_2_PORT=5015
