# public http port for the nginx entry service
NGINX_PUBLIC_PORT=80

# keep the public host names aligned with the current project domain
NGINX_SERVER_NAME=ttz3305012.uk www.ttz3305012.uk

# keep the frontend api target aligned with the current public frontend config
VITE_API_BASE_URL=http://ttz3305012.uk

# keep the current project debug mode aligned with the existing public env
DEBUG=True

# keep the current project secret key aligned with the existing env files
SECRET_KEY=django-insecure-change-this-later

# keep the public host names aligned with the current project domain
ALLOWED_HOSTS=127.0.0.1,localhost,ttz3305012.uk,www.ttz3305012.uk

# keep cross-origin settings aligned with the current public project config
CORS_ALLOWED_ORIGINS=http://ttz3305012.uk,http://www.ttz3305012.uk,https://ttz3305012.uk,https://www.ttz3305012.uk
CSRF_TRUSTED_ORIGINS=http://ttz3305012.uk,http://www.ttz3305012.uk,https://ttz3305012.uk,https://www.ttz3305012.uk

# keep the current proxy header behavior aligned with the existing project config
USE_X_FORWARDED_HOST=False
USE_SECURE_PROXY_SSL_HEADER=False

# keep the cookie behavior aligned with the existing project config
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# keep the backend process port internal to the compose stack
BACKEND_APP_PORT=8000

# tune gunicorn for a small public demo server
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120

# keep the application database identity aligned with the current project config
POSTGRESQL_DATABASE=studyroom
POSTGRESQL_USERNAME=studyuser
POSTGRESQL_PASSWORD=study123456
POSTGRESQL_POSTGRES_PASSWORD=studyroot123456
POSTGRESQL_REPLICATION_USER=replicator
POSTGRESQL_REPLICATION_PASSWORD=replicator123456

# keep unsafe http methods on the primary database
DB_FORCE_PRIMARY_FOR_UNSAFE_METHODS=True

# keep redis cluster authentication aligned with the current project config
REDIS_PASSWORD=studyredis123456
REDIS_CLUSTER_ENABLED=True
REDIS_CLUSTER_READ_FROM_REPLICAS=True
REDIS_CLUSTER_REQUIRE_FULL_COVERAGE=True

# keep the grpc service discovery explicit inside the compose network
JAVA_RECOMMENDATION_GRPC_TARGET=java-recommendation-service:5101
GO_AVAILABILITY_GRPC_TARGET=go-availability-service:5102
JAVA_BOOKING_LIFECYCLE_GRPC_TARGET=java-recommendation-service:5101
