# keep the frontend upstream explicit even though it is a single container today
upstream studyroom_frontend_pool {
    server frontend-app:80 max_fails=3 fail_timeout=30s;
    keepalive 16;
}

# keep two django containers behind nginx for api load balancing
upstream studyroom_backend_pool {
    least_conn;
    server backend-app-1:${BACKEND_APP_PORT} max_fails=3 fail_timeout=30s;
    server backend-app-2:${BACKEND_APP_PORT} max_fails=3 fail_timeout=30s;
    keepalive 32;
}

server {
    listen 80;
    server_name ${NGINX_SERVER_NAME};

    # keep a simple endpoint for the nginx health check
    location = /nginx-healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 'ok';
    }

    # serve django collected static files directly from the shared volume
    location /static/ {
        alias /var/www/backend-static/;
        expires 1h;
        add_header Cache-Control "public";
    }

    # proxy django admin traffic to the backend pool
    location /manage/ {
        proxy_pass http://studyroom_backend_pool;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
        proxy_next_upstream error timeout http_502 http_503 http_504;
    }

    # proxy api traffic to the backend pool
    location /api/ {
        proxy_pass http://studyroom_backend_pool;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
        proxy_next_upstream error timeout http_502 http_503 http_504;
    }

    # proxy the react frontend to the dedicated frontend container
    location / {
        proxy_pass http://studyroom_frontend_pool;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
    }
}
